# Prefer OpenAI (recommended when you have a sk-proj / sk- key)
OPENAI_API_KEY=sk-your-openai-key-here
AI_PROVIDER=openai

# Optional image model override (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional OpenRouter (only used if AI_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# AI_PROVIDER=openrouter
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# Optional OpenRouter model overrides
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_MODEL_MINI=openai/gpt-4o-mini

# Optional: override GraphQL RAG endpoint
# GRAPHQL_ENDPOINT=https://countries.trevorblades.com/
