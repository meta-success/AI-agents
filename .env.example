# Use OpenRouter (recommended for this project)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: force provider (openrouter | openai)
# AI_PROVIDER=openrouter

# Optional OpenRouter model overrides
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_MODEL_MINI=openai/gpt-4o-mini

# Or use a native OpenAI key instead:
# OPENAI_API_KEY=sk-your-openai-key

# Optional: override the default GraphQL endpoint used for RAG enrichment
# GRAPHQL_ENDPOINT=https://countries.trevorblades.com/
